# ── Meta Conversions API (CAPI) — set these in Vercel env vars, not in git ──
# Pixel ID (same as the browser Pixel in the landing page)
META_PIXEL_ID=955572904130075
# System-user access token with Conversions API permission (from your friend's BM)
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager → Test events code, to validate before going live
META_TEST_EVENT_CODE=
# Optional: Graph API version
META_GRAPH_VERSION=v23.0
# Optional: signing key from Calendly webhook subscription (recommended)
CALENDLY_WEBHOOK_SIGNING_KEY=
# Optional: canonical landing URL used as event_source_url
SITE_URL=https://YOUR-DOMAIN/settingav/
